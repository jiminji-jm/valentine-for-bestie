<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Bestie, Be My Valentine ❤️</title>

<style>
body {
    text-align: center;
    font-family: 'Comic Sans MS', cursive;
    background: linear-gradient(135deg, #ff9a9e, #fecfef);
    overflow: hidden;
}

h1 {
    margin-top: 100px;
    font-size: 45px;
    color: white;
    text-shadow: 2px 2px 5px #ff4d6d;
}

p {
    font-size: 22px;
    color: white;
}

.btn {
    padding: 15px 35px;
    font-size: 20px;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    margin: 20px;
    position: absolute;
    transition: 0.2s;
}

#yesBtn {
    background-color: #ff4d6d;
    color: white;
    left: 40%;
    top: 55%;
}

#noBtn {
    background-color: #6c757d;
    color: white;
    left: 55%;
    top: 55%;
}

#loveMessage {
    margin-top: 300px;
    font-size: 35px;
    color: white;
    display: none;
    animation: pop 1s ease-in-out infinite alternate;
}

@keyframes pop {
    from { transform: scale(1); }
    to { transform: scale(1.1); }
}
</style>
</head>

<body>

<h1>Bestie ❤️</h1>
<p>In filmy slow motion... with violins playing 🎻✨</p>
<h2 style="color:white;">Will You Be My Valentine? 💌</h2>

<button id="yesBtn" class="btn" onclick="sayYes()">Yes, obviously 😍</button>
<button id="noBtn" class="btn">No 😢</button>

<div id="loveMessage">
    YAYYYYY ❤️🥰  
    You just made my heart do dhak dhak 💃✨  
    I love youuu Bestie 💕
</div>

<script>
const noBtn = document.getElementById("noBtn");

noBtn.addEventListener("mouseover", function() {
    const x = Math.random() * (window.innerWidth - 150);
    const y = Math.random() * (window.innerHeight - 100);
    noBtn.style.left = x + "px";
    noBtn.style.top = y + "px";
});

function sayYes() {
    document.getElementById("loveMessage").style.display = "block";
}
</script>

</body>
</html>
